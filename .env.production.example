# =====================================================================
# Environment variables for PRODUCTION
# Define them in your hosting platform dashboard (Railway / Render /
# Fly.io / etc.). DO NOT commit real values to the repository.
#
# Environment variables ALWAYS take precedence over application.yml.
# =====================================================================

# --- Active profile (required) ---
# Activates application-prod.yml (SQL disabled, secure seeding, hardened errors).
SPRING_PROFILES_ACTIVE=prod

# --- Port (usually injected automatically by the platform) ---
# If the platform defines PORT, you do not need to set it. Default: 3000.
# PORT=3000

# --- Managed PostgreSQL database (required) ---
DATABASE_URL=jdbc:postgresql://HOST:5432/NOMBRE_BD
DB_USERNAME=usuario_bd
DB_PASSWORD=contraseña_segura_bd

# --- Managed Redis (REQUIRED: login and sessions need Redis) ---
REDIS_HOST=host-redis
REDIS_PORT=6379
REDIS_PASSWORD=contraseña_redis
# Most cloud Redis providers require TLS. Set "true" when the provider uses rediss://
REDIS_TLS=true

# --- JWT secret (required; DO NOT use the repository default) ---
# Generate a strong value, for example: openssl rand -base64 48
JWT_SECRET=reemplaza_por_un_secreto_largo_y_aleatorio_de_al_menos_32_bytes

# --- Frontend origins authorized by CORS (required) ---
# Comma-separated list. Wildcards are supported for Vercel previews.
APP_FRONTEND_URLS=https://tu-app.vercel.app,https://*.vercel.app

# --- Seed the first SUPER_ADMIN (recommended for the initial deployment) ---
# Used once to create the platform administrator when it does not exist.
# These variables can be removed after the first successful startup.
SEED_SUPER_ADMIN_EMAIL=superadmin@tu-dominio.com
SEED_SUPER_ADMIN_PASSWORD=contraseña_fuerte_min_6_caracteres
